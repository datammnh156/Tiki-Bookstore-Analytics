# ===============================================
# .gitignore for Tiki Books Analysis Project
# ===============================================

# ===== FOLDERS TO IGNORE =====
# Archive folder (old/test files)
archive/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# ===== PYTHON =====
# Virtual Environment
venv/
env/
ENV/
.venv

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# ===== DATA FILES (Optional - uncomment if needed) =====
# Uncomment these if files are too large for GitHub
# data/raw/*.csv
# data/clean/*.csv
# models/*.pkl

# ===== POWER BI (Optional) =====
# Uncomment if .pbix file is too large (>100MB)
# *.pbix

# ===== OS SPECIFIC =====
# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ===== OTHER =====
# Environment variables
.env
.env.local

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp